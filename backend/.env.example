# Security — change this in production (generate: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=dev-secret-key-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider: "gemini" or "ollama"
LLM_PROVIDER=gemini

# Google Gemini Settings (Get free API key at: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama Settings (fallback / alternative)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4

# CORS (comma-separated list; "*" for local dev)
CORS_ORIGINS=["*"]