# =============================================================================
#  RAG Q&A backend settings  -  copy to backend/.env:  cp .env.example .env
# -----------------------------------------------------------------------------
#  - This file holds secrets: it is git-ignored. Never commit it.
#  - .env.example is the shareable copy with the same settings and no secrets.
#  - Restart the backend after you change anything here.
#  - A real environment variable with the same name overrides this file.
# =============================================================================

# --- Security -----------------------------------------------------------------
# development | production. In production the backend refuses to start with
# the dev SECRET_KEY or a key shorter than 32 characters.
ENVIRONMENT=development
# JWT signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-secret-key-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# =============================================================================
#  LLM  -  which AI model writes the answers
# =============================================================================
# Switch provider by changing this ONE line:
#   gemini  -> Google Gemini   (needs GEMINI_API_KEY)
#   claude  -> Anthropic Claude (needs ANTHROPIC_API_KEY)
#   ollama  -> local model on this computer (free, offline, needs Ollama running)
LLM_PROVIDER=gemini

# Shared limits (apply to every provider)
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=300

# --- Google Gemini ------------------------------------------------------------
# Key: https://aistudio.google.com/app/apikey
# The free tier has small daily limits; enable billing for real use.
GEMINI_API_KEY=
# Examples: gemini-2.5-flash (fast, cheap), gemini-2.5-pro (stronger)
GEMINI_MODEL=gemini-2.5-flash

# --- Anthropic Claude ---------------------------------------------------------
# Key: https://platform.claude.com  (API billing is separate from a Claude Pro plan)
ANTHROPIC_API_KEY=
# claude-opus-5-5    most accurate   ($4 / $20 per 1M tokens in / out)
# claude-sonnet-5-5  balanced        ($2 / $10)
# claude-haiku-5-5   fastest/cheapest ($0.10 / $0.50)
CLAUDE_MODEL=claude-opus-5-5
# How hard Claude thinks before answering: low | medium | high | xhigh | max
# Higher = more careful but slower and more tokens. medium suits document Q&A.
CLAUDE_EFFORT=medium

# --- Ollama (local) -----------------------------------------------------------
# Install: https://ollama.com   then:  ollama pull <model>
OLLAMA_URL=http://localhost:11434
# Examples: gemma4, qwen3:4b, llama3.1, mistral
OLLAMA_MODEL=gemma4
# Context window in tokens; bigger reads more text but needs more memory.
OLLAMA_NUM_CTX=4096

# --- Search -------------------------------------------------------------------
# Chunks fetched for each question, then rescored and reranked.
RETRIEVAL_CANDIDATES=40
# Best chunks the AI reads (each up to ~512 tokens). With Ollama, keep
# RETRIEVAL_TOP_K x 600 below OLLAMA_NUM_CTX, or raise OLLAMA_NUM_CTX to 8192.
RETRIEVAL_TOP_K=5

# --- Server -------------------------------------------------------------------
MAX_UPLOAD_MB=50
# Allowed frontend origins as a JSON list. ["*"] is for local development only.
CORS_ORIGINS=["*"]
